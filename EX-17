import pandas as pd
from sklearn.linear_model import LinearRegression
data = {
    "RAM": [2, 3, 4, 6, 8, 12],
    "Storage": [32, 64, 64, 128, 256, 256],
    "Camera": [12, 13, 16, 48, 50, 108],
    "Battery": [3000, 3500, 4000, 4500, 5000, 6000],
    "Price": [8000, 10000, 14000, 22000, 35000, 50000]
}
df = pd.DataFrame(data)
X = df[["RAM", "Storage", "Camera", "Battery"]]
y = df["Price"]
model = LinearRegression()
model.fit(X, y)
ram = float(input("Enter RAM (GB): "))
storage = float(input("Enter Storage (GB): "))
camera = float(input("Enter Camera (MP): "))
battery = float(input("Enter Battery (mAh): "))
new_mobile = pd.DataFrame(
    [[ram, storage, camera, battery]],
    columns=["RAM", "Storage", "Camera", "Battery"]
)
price = model.predict(new_mobile)
print("Predicted Mobile Price:", round(price[0], 2))
