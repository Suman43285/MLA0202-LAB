import pandas as pd
from sklearn.linear_model import LogisticRegression
data = {
    "Income": [25000, 50000, 30000, 70000, 20000, 60000],
    "Debt": [20000, 10000, 25000, 5000, 30000, 8000],
    "PaymentHistory": [1, 1, 0, 1, 0, 1],
    "CreditScore": [0, 1, 0, 1, 0, 1]
}
df = pd.DataFrame(data)
X = df[["Income", "Debt", "PaymentHistory"]]
y = df["CreditScore"]
model = LogisticRegression()
model.fit(X, y)
new_customer = pd.DataFrame(
    [[45000, 12000, 1]],
    columns=["Income", "Debt", "PaymentHistory"]
)
prediction = model.predict(new_customer)
print("Credit Score Classification:",
      "Good" if prediction[0] == 1 else "Poor")
